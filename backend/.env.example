# Copy this file to .env and fill in real values. Never commit .env.

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# Set to true only on your own machine while developing.
FLASK_DEBUG=false

# The address the frontend runs on (only this site may call the API).
CORS_ORIGIN=http://localhost:3000

# Local Ollama server and model used by FinGan chat.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
